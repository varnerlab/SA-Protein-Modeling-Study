\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Properties of the seven Pfam families used in this study. $K$: number of seed sequences after cleaning. $L$: alignment length (columns retained). $d$: PCA dimension (95\% variance). $\bar  {H}_{\mathrm  {col}}$: mean per-column Shannon entropy (nats). $K_{\mathrm  {eff}}$: effective number of sequences at 80\% identity threshold. $\beta ^*$: empirical entropy inflection point. $\beta ^*/\!\sqrt  {d}$: ratio to the random-pattern prediction.}}{14}{table.caption.25}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:families}{{1}{14}{Properties of the seven Pfam families used in this study. $K$: number of seed sequences after cleaning. $L$: alignment length (columns retained). $d$: PCA dimension (95\% variance). $\bar {H}_{\mathrm {col}}$: mean per-column Shannon entropy (nats). $K_{\mathrm {eff}}$: effective number of sequences at 80\% identity threshold. $\beta ^*$: empirical entropy inflection point. $\beta ^*/\!\sqrt {d}$: ratio to the random-pattern prediction}{table.caption.25}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat  {\boldsymbol  {\xi }}, \mathbf  {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better, indicating greater novelty). Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each.}}{14}{table.caption.26}\protected@file@percent }
\newlabel{tab:results}{{2}{14}{Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat {\boldsymbol {\xi }}, \mathbf {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better, indicating greater novelty). Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each}{table.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cross-family comparison of SA generation, SA retrieval, and bootstrap across seven Pfam families. \textbf  {(A)}~KL divergence of amino acid composition (lower is better). SA generation achieves the lowest or near-lowest KL in every family. \textbf  {(B)}~Novelty in sequence space ($1 - \text  {max seq.\ identity}$; higher is better). SA generation produces substantially novel sequences, while bootstrap and Gaussian perturbation remain near zero. \textbf  {(C)}~Nearest sequence identity to a stored pattern (lower indicates greater departure). Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples).}}{15}{figure.caption.27}\protected@file@percent }
\newlabel{fig:cross-family}{{1}{15}{Cross-family comparison of SA generation, SA retrieval, and bootstrap across seven Pfam families. \textbf {(A)}~KL divergence of amino acid composition (lower is better). SA generation achieves the lowest or near-lowest KL in every family. \textbf {(B)}~Novelty in sequence space ($1 - \text {max seq.\ identity}$; higher is better). SA generation produces substantially novel sequences, while bootstrap and Gaussian perturbation remain near zero. \textbf {(C)}~Nearest sequence identity to a stored pattern (lower indicates greater departure). Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples)}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf  {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf  {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf  {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf  {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE.}}{16}{figure.caption.28}\protected@file@percent }
\newlabel{fig:scaling}{{2}{16}{Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Predicting the critical temperature from MSA statistics. \textbf  {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt  {d}$ ($R^2{=}0.97$, $n{=}32$). Blue circles: seven Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots  ,400\}$, five repeats each). \textbf  {(B)}~$\beta ^*$ as a function of $\sqrt  {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt  {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf  {(C)}~Model comparison (log-scale RMSE). The simple $\sqrt  {d}$ model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt  {d}$ (RMSE${=}5.29$); adding MSA features provides negligible improvement.}}{16}{figure.caption.29}\protected@file@percent }
\newlabel{fig:beta-prediction}{{3}{16}{Predicting the critical temperature from MSA statistics. \textbf {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt {d}$ ($R^2{=}0.97$, $n{=}32$). Blue circles: seven Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots ,400\}$, five repeats each). \textbf {(B)}~$\beta ^*$ as a function of $\sqrt {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf {(C)}~Model comparison (log-scale RMSE). The simple $\sqrt {d}$ model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt {d}$ (RMSE${=}5.29$); adding MSA features provides negligible improvement}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Head-to-head comparison of SA generation against learned baselines across all seven Pfam families. \textbf  {(A)}~KL divergence of amino acid composition. \textbf  {(B)}~Novelty in PCA space. \textbf  {(C)}~Nearest sequence identity. Significance brackets show Wilcoxon rank-sum tests comparing SA generation to HMM emit (the most direct comparison, as both use only the seed alignment): $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples).}}{17}{figure.caption.30}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{4}{17}{Head-to-head comparison of SA generation against learned baselines across all seven Pfam families. \textbf {(A)}~KL divergence of amino acid composition. \textbf {(B)}~Novelty in PCA space. \textbf {(C)}~Nearest sequence identity. Significance brackets show Wilcoxon rank-sum tests comparing SA generation to HMM emit (the most direct comparison, as both use only the seed alignment): $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples)}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Structure validation of SA-generated sequences using ESMFold. \textbf  {(A)}~Mean pLDDT (folding confidence) across seven Pfam families for SA generation, SA retrieval, bootstrap, and stored (natural) sequences. The dashed line indicates the pLDDT${=}70$ confidence threshold. \textbf  {(B)}~TM-score to a representative experimentally determined structure for each family. The dashed line indicates TM${=}0.5$ (same-fold threshold). Significance brackets show Wilcoxon rank-sum tests comparing SA generation to stored sequences: $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. Error bars show $\pm 1$ SE ($n{=}50$ sequences per condition).}}{18}{figure.caption.31}\protected@file@percent }
\newlabel{fig:structure-validation}{{5}{18}{Structure validation of SA-generated sequences using ESMFold. \textbf {(A)}~Mean pLDDT (folding confidence) across seven Pfam families for SA generation, SA retrieval, bootstrap, and stored (natural) sequences. The dashed line indicates the pLDDT${=}70$ confidence threshold. \textbf {(B)}~TM-score to a representative experimentally determined structure for each family. The dashed line indicates TM${=}0.5$ (same-fold threshold). Significance brackets show Wilcoxon rank-sum tests comparing SA generation to stored sequences: $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. Error bars show $\pm 1$ SE ($n{=}50$ sequences per condition)}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces AlphaFold2 predicted structures for representative SA-generated sequences (colored by per-residue pLDDT confidence) superimposed on the experimentally determined reference structure for each family (gray, semi-transparent). For each family, the SA-generated sequence with the highest mean pLDDT was selected and aligned to the reference using PyMOL. The close structural agreement (sub-angstrom RMSD) and uniformly high pLDDT scores confirm that SA-generated sequences, despite substantial sequence-level novelty, encode three-dimensional folds that faithfully recapitulate the canonical architecture of their target family.}}{18}{figure.caption.32}\protected@file@percent }
\newlabel{fig:structure-gallery}{{6}{18}{AlphaFold2 predicted structures for representative SA-generated sequences (colored by per-residue pLDDT confidence) superimposed on the experimentally determined reference structure for each family (gray, semi-transparent). For each family, the SA-generated sequence with the highest mean pLDDT was selected and aligned to the reference using PyMOL. The close structural agreement (sub-angstrom RMSD) and uniformly high pLDDT scores confirm that SA-generated sequences, despite substantial sequence-level novelty, encode three-dimensional folds that faithfully recapitulate the canonical architecture of their target family}{figure.caption.32}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces Per-position amino acid frequency profiles for the RRM family (PF00076). \textbf  {Top:} stored seed sequences ($K{=}68$). \textbf  {Bottom:} SA-generated sequences ($S{=}150$, retrieval regime). The generated ensemble reproduces the position-specific conservation pattern of the family, including strongly conserved positions and variable regions.}}{19}{figure.caption.35}\protected@file@percent }
\newlabel{fig:aa-freq}{{S1}{19}{Per-position amino acid frequency profiles for the RRM family (PF00076). \textbf {Top:} stored seed sequences ($K{=}68$). \textbf {Bottom:} SA-generated sequences ($S{=}150$, retrieval regime). The generated ensemble reproduces the position-specific conservation pattern of the family, including strongly conserved positions and variable regions}{figure.caption.35}{}}
