\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat  {\boldsymbol  {\xi }}, \mathbf  {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better, indicating greater novelty). Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each.}}{11}{table.caption.25}\protected@file@percent }
\newlabel{tab:results}{{2}{11}{Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat {\boldsymbol {\xi }}, \mathbf {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better, indicating greater novelty). Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each}{table.caption.25}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cross-family comparison of SA generation, SA retrieval, and bootstrap across seven Pfam families. \textbf  {(A)}~KL divergence of amino acid composition (lower is better). SA generation achieves the lowest or near-lowest KL in every family. \textbf  {(B)}~Novelty in sequence space ($1 - \text  {max seq.\ identity}$; higher is better). SA generation produces substantially novel sequences, while bootstrap and Gaussian perturbation remain near zero. \textbf  {(C)}~Nearest sequence identity to a stored pattern (lower indicates greater departure). Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples).}}{12}{figure.caption.26}\protected@file@percent }
\newlabel{fig:cross-family}{{1}{12}{Cross-family comparison of SA generation, SA retrieval, and bootstrap across seven Pfam families. \textbf {(A)}~KL divergence of amino acid composition (lower is better). SA generation achieves the lowest or near-lowest KL in every family. \textbf {(B)}~Novelty in sequence space ($1 - \text {max seq.\ identity}$; higher is better). SA generation produces substantially novel sequences, while bootstrap and Gaussian perturbation remain near zero. \textbf {(C)}~Nearest sequence identity to a stored pattern (lower indicates greater departure). Error bars show $\pm 1$ SE (30 chains $\times $ 5 samples)}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-position amino acid frequency profiles for the RRM family (PF00076). \textbf  {Top:} stored seed sequences ($K{=}68$). \textbf  {Bottom:} SA-generated sequences ($S{=}150$, retrieval regime). The generated ensemble reproduces the position-specific conservation pattern of the family, including strongly conserved positions and variable regions.}}{13}{figure.caption.27}\protected@file@percent }
\newlabel{fig:aa-freq}{{2}{13}{Per-position amino acid frequency profiles for the RRM family (PF00076). \textbf {Top:} stored seed sequences ($K{=}68$). \textbf {Bottom:} SA-generated sequences ($S{=}150$, retrieval regime). The generated ensemble reproduces the position-specific conservation pattern of the family, including strongly conserved positions and variable regions}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf  {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf  {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf  {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf  {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE.}}{14}{figure.caption.28}\protected@file@percent }
\newlabel{fig:scaling}{{3}{14}{Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Predicting the critical temperature from MSA statistics. \textbf  {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt  {d}$ ($R^2{=}0.97$, $n{=}32$). Blue circles: seven Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots  ,400\}$, five repeats each). \textbf  {(B)}~$\beta ^*$ as a function of $\sqrt  {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt  {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf  {(C)}~Model comparison (log-scale RMSE). The simple $\sqrt  {d}$ model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt  {d}$ (RMSE${=}5.29$); adding MSA features provides negligible improvement.}}{14}{figure.caption.29}\protected@file@percent }
\newlabel{fig:beta-prediction}{{4}{14}{Predicting the critical temperature from MSA statistics. \textbf {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt {d}$ ($R^2{=}0.97$, $n{=}32$). Blue circles: seven Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots ,400\}$, five repeats each). \textbf {(B)}~$\beta ^*$ as a function of $\sqrt {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf {(C)}~Model comparison (log-scale RMSE). The simple $\sqrt {d}$ model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt {d}$ (RMSE${=}5.29$); adding MSA features provides negligible improvement}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Head-to-head comparison of SA generation against learned baselines across seven Pfam families (six for EvoDiff, which could not complete Pkinase in feasible time). \textbf  {(A)}~KL divergence of amino acid composition. EvoDiff and HMM emit achieve the lowest KL values, benefiting from pretrained weights (EvoDiff) or direct alignment statistics (HMM). SA generation maintains competitive KL without any external training data. \textbf  {(B)}~Novelty in PCA space. All methods except bootstrap produce substantial novelty; HMM emit is highest but at the cost of structural plausibility (see panel C). \textbf  {(C)}~Nearest sequence identity. HMM emit and MSA Transformer produce sequences with very low identity to any stored pattern ($9$--$42\%$), suggesting sequences that may fall outside the family's functional envelope. SA generation occupies a unique middle ground ($51$--$61\%$). Error bars show $\pm 1$ SE.}}{15}{figure.caption.30}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{5}{15}{Head-to-head comparison of SA generation against learned baselines across seven Pfam families (six for EvoDiff, which could not complete Pkinase in feasible time). \textbf {(A)}~KL divergence of amino acid composition. EvoDiff and HMM emit achieve the lowest KL values, benefiting from pretrained weights (EvoDiff) or direct alignment statistics (HMM). SA generation maintains competitive KL without any external training data. \textbf {(B)}~Novelty in PCA space. All methods except bootstrap produce substantial novelty; HMM emit is highest but at the cost of structural plausibility (see panel C). \textbf {(C)}~Nearest sequence identity. HMM emit and MSA Transformer produce sequences with very low identity to any stored pattern ($9$--$42\%$), suggesting sequences that may fall outside the family's functional envelope. SA generation occupies a unique middle ground ($51$--$61\%$). Error bars show $\pm 1$ SE}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Structure validation of SA-generated sequences using ESMFold. \textbf  {(A)}~Mean pLDDT (folding confidence) across seven Pfam families for SA generation, SA retrieval, bootstrap, and stored (natural) sequences. The dashed line indicates the pLDDT${=}70$ confidence threshold. SA-generated sequences achieve pLDDT comparable to stored sequences in every family. \textbf  {(B)}~TM-score to a representative experimentally determined structure for each family. The dashed line indicates TM${=}0.5$ (same-fold threshold). In families with well-matched reference lengths (SH3, Kunitz, PDZ, Pkinase), SA-generated sequences consistently achieve the same fold as stored sequences. Error bars show $\pm 1$ SE ($n{=}50$ sequences per condition).}}{16}{figure.caption.31}\protected@file@percent }
\newlabel{fig:structure-validation}{{6}{16}{Structure validation of SA-generated sequences using ESMFold. \textbf {(A)}~Mean pLDDT (folding confidence) across seven Pfam families for SA generation, SA retrieval, bootstrap, and stored (natural) sequences. The dashed line indicates the pLDDT${=}70$ confidence threshold. SA-generated sequences achieve pLDDT comparable to stored sequences in every family. \textbf {(B)}~TM-score to a representative experimentally determined structure for each family. The dashed line indicates TM${=}0.5$ (same-fold threshold). In families with well-matched reference lengths (SH3, Kunitz, PDZ, Pkinase), SA-generated sequences consistently achieve the same fold as stored sequences. Error bars show $\pm 1$ SE ($n{=}50$ sequences per condition)}{figure.caption.31}{}}
