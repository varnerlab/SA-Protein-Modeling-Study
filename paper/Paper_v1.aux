\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition (lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat  {\boldsymbol  {\xi }}, \mathbf  {m}_k)$ in PCA space (higher means more novel). SeqID: nearest sequence identity after decoding. Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each.}}{9}{table.caption.22}\protected@file@percent }
\newlabel{tab:results}{{2}{9}{Generation metrics across seven Pfam families (mean $\pm $ SE). SA gen: stochastic attention generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: KL divergence of amino acid composition (lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat {\boldsymbol {\xi }}, \mathbf {m}_k)$ in PCA space (higher means more novel). SeqID: nearest sequence identity after decoding. Standard errors for novelty and SeqID are computed over 30 independent chains of 5 samples each}{table.caption.22}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Generation quality as a function of family size. The WW domain was subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates per condition. Error bars show $\pm 1$ SE. Note the log scale on both axes: SA generation (blue) maintains low KL divergence across the entire range, while the convex combination baseline (purple) degrades catastrophically.}}{10}{figure.caption.25}\protected@file@percent }
\newlabel{fig:scaling}{{3}{10}{Generation quality as a function of family size. The WW domain was subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates per condition. Error bars show $\pm 1$ SE. Note the log scale on both axes: SA generation (blue) maintains low KL divergence across the entire range, while the convex combination baseline (purple) degrades catastrophically}{figure.caption.25}{}}
