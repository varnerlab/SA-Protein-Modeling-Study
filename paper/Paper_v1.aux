\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces \textbf  {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores; the dashed line is a linear fit in $\sqrt  {2\log K}$. (B)~Similarity variance $\sigma ^2 = \mathrm  {Var}(\mathbf  {m}_k^\top \boldsymbol  {\xi })$ vs.\ $1/d$ for random probes; all points lie on the identity line, confirming $\sigma ^2 = 1/d$. (C)~Gaussian prediction $\beta ^*_{\mathrm  {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; the prediction has the correct trend ($r = 0.98$) but overshoots by $\sim \!4\times $. (D)~Same as (C) using the empirical (non-Gaussian) $\tau ^*$; the overshoot persists. (E)~Excess kurtosis of the similarity distribution across families. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming the concentration-of-measure prediction $\sigma ^2 d = 1$.}}{21}{figure.caption.40}\protected@file@percent }
\newlabel{fig:analytical-beta}{{S2}{21}{\textbf {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores; the dashed line is a linear fit in $\sqrt {2\log K}$. (B)~Similarity variance $\sigma ^2 = \mathrm {Var}(\mathbf {m}_k^\top \boldsymbol {\xi })$ vs.\ $1/d$ for random probes; all points lie on the identity line, confirming $\sigma ^2 = 1/d$. (C)~Gaussian prediction $\beta ^*_{\mathrm {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; the prediction has the correct trend ($r = 0.98$) but overshoots by $\sim \!4\times $. (D)~Same as (C) using the empirical (non-Gaussian) $\tau ^*$; the overshoot persists. (E)~Excess kurtosis of the similarity distribution across families. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming the concentration-of-measure prediction $\sigma ^2 d = 1$}{figure.caption.40}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces \textbf  {Stored-pattern probe analysis.} (A)~Validation: $\beta ^*$ recomputed from stored-pattern inflection vs.\ the value from \texttt  {find\_entropy\_inflection} ($R^2 = 0.924$). (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance ($1/d$); stored probes systematically deviate from the identity line. (C)~Variance ratio $\sigma ^2_{\mathrm  {cross}}/\sigma ^2_{\mathrm  {random}}$ vs.\ $d$; no consistent relationship. (D)~The decomposition $\tau ^*_{\mathrm  {stored}}/\sigma _{\mathrm  {cross}}$ fails as a predictor of $\beta ^*$ ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta = 1 - \max _{j\neq  k}\mathbf  {m}_j^\top \mathbf  {m}_k$ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$); the gap has moderate predictive power but is noisier than $\sqrt  {d}$.}}{22}{figure.caption.41}\protected@file@percent }
\newlabel{fig:stored-pattern}{{S3}{22}{\textbf {Stored-pattern probe analysis.} (A)~Validation: $\beta ^*$ recomputed from stored-pattern inflection vs.\ the value from \texttt {find\_entropy\_inflection} ($R^2 = 0.924$). (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance ($1/d$); stored probes systematically deviate from the identity line. (C)~Variance ratio $\sigma ^2_{\mathrm {cross}}/\sigma ^2_{\mathrm {random}}$ vs.\ $d$; no consistent relationship. (D)~The decomposition $\tau ^*_{\mathrm {stored}}/\sigma _{\mathrm {cross}}$ fails as a predictor of $\beta ^*$ ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta = 1 - \max _{j\neq k}\mathbf {m}_j^\top \mathbf {m}_k$ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$); the gap has moderate predictive power but is noisier than $\sqrt {d}$}{figure.caption.41}{}}
\gdef \@abspage@last{22}
