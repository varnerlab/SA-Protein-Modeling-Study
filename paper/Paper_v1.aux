\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf  {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf  {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf  {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf  {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE.}}{31}{figure.caption.36}\protected@file@percent }
\newlabel{fig:scaling}{{S2}{31}{Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf {(A)}~KL divergence (log--log scale). SA generation maintains low KL across the entire range; convex combination degrades catastrophically. \textbf {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces Pairwise mutual information (MI) scatter plots for three representative families. Each point represents one position pair $(i, j)$; the $x$-axis is MI computed from the stored seed alignment and the $y$-axis is MI from SA-generated sequences. Red points indicate structurally contacting residue pairs (C$\alpha $--C$\alpha $ distance ${<}8$~\r A, sequence separation ${\geq }5$ residues), identified from the family reference PDB structure. The dashed line is the identity. Pearson $r$ and Spearman $\rho $ are shown in each panel title.}}{31}{figure.caption.47}\protected@file@percent }
\newlabel{fig:mi-scatter}{{S3}{31}{Pairwise mutual information (MI) scatter plots for three representative families. Each point represents one position pair $(i, j)$; the $x$-axis is MI computed from the stored seed alignment and the $y$-axis is MI from SA-generated sequences. Red points indicate structurally contacting residue pairs (C$\alpha $--C$\alpha $ distance ${<}8$~\AA , sequence separation ${\geq }5$ residues), identified from the family reference PDB structure. The dashed line is the identity. Pearson $r$ and Spearman $\rho $ are shown in each panel title}{figure.caption.47}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces PCA variance threshold sensitivity study. For each family and retained-variance threshold, the table reports the PCA dimension $d$, empirical critical temperature $\beta ^*$, generation temperature $\beta _{\mathrm  {gen}}$, amino acid composition KL divergence, PCA-space cosine novelty, and nearest sequence identity to a stored pattern. All conditions produced 100\% valid amino acid residues.}}{32}{table.caption.49}\protected@file@percent }
\newlabel{tab:pca-sensitivity}{{S6}{32}{PCA variance threshold sensitivity study. For each family and retained-variance threshold, the table reports the PCA dimension $d$, empirical critical temperature $\beta ^*$, generation temperature $\beta _{\mathrm {gen}}$, amino acid composition KL divergence, PCA-space cosine novelty, and nearest sequence identity to a stored pattern. All conditions produced 100\% valid amino acid residues}{table.caption.49}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \textbf  {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores; the dashed line is a linear fit in $\sqrt  {2\log K}$. (B)~Similarity variance $\sigma ^2 = \mathrm  {Var}(\mathbf  {m}_k^\top \boldsymbol  {\xi })$ vs.\ $1/d$ for random probes; all points lie on the identity line, confirming $\sigma ^2 = 1/d$. (C)~Gaussian prediction $\beta ^*_{\mathrm  {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; the prediction has the correct trend ($r = 0.98$) but overshoots by $\sim \!4\times $. (D)~Same as (C) using the empirical (non-Gaussian) $\tau ^*$; the overshoot persists. (E)~Excess kurtosis of the similarity distribution across families. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming the concentration-of-measure prediction $\sigma ^2 d = 1$.}}{33}{figure.caption.69}\protected@file@percent }
\newlabel{fig:analytical-beta}{{S4}{33}{\textbf {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores; the dashed line is a linear fit in $\sqrt {2\log K}$. (B)~Similarity variance $\sigma ^2 = \mathrm {Var}(\mathbf {m}_k^\top \boldsymbol {\xi })$ vs.\ $1/d$ for random probes; all points lie on the identity line, confirming $\sigma ^2 = 1/d$. (C)~Gaussian prediction $\beta ^*_{\mathrm {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; the prediction has the correct trend ($r = 0.98$) but overshoots by $\sim \!4\times $. (D)~Same as (C) using the empirical (non-Gaussian) $\tau ^*$; the overshoot persists. (E)~Excess kurtosis of the similarity distribution across families. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming the concentration-of-measure prediction $\sigma ^2 d = 1$}{figure.caption.69}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \textbf  {Stored-pattern probe analysis.} (A)~Validation: $\beta ^*$ recomputed from stored-pattern inflection vs.\ the value from \texttt  {find\_entropy\_inflection} ($R^2 = 0.924$). (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance ($1/d$); stored probes systematically deviate from the identity line. (C)~Variance ratio $\sigma ^2_{\mathrm  {cross}}/\sigma ^2_{\mathrm  {random}}$ vs.\ $d$; no consistent relationship. (D)~The decomposition $\tau ^*_{\mathrm  {stored}}/\sigma _{\mathrm  {cross}}$ fails as a predictor of $\beta ^*$ ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta = 1 - \max _{j\neq  k}\mathbf  {m}_j^\top \mathbf  {m}_k$ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$); the gap has moderate predictive power but is noisier than $\sqrt  {d}$.}}{34}{figure.caption.70}\protected@file@percent }
\newlabel{fig:stored-pattern}{{S5}{34}{\textbf {Stored-pattern probe analysis.} (A)~Validation: $\beta ^*$ recomputed from stored-pattern inflection vs.\ the value from \texttt {find\_entropy\_inflection} ($R^2 = 0.924$). (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance ($1/d$); stored probes systematically deviate from the identity line. (C)~Variance ratio $\sigma ^2_{\mathrm {cross}}/\sigma ^2_{\mathrm {random}}$ vs.\ $d$; no consistent relationship. (D)~The decomposition $\tau ^*_{\mathrm {stored}}/\sigma _{\mathrm {cross}}$ fails as a predictor of $\beta ^*$ ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta = 1 - \max _{j\neq k}\mathbf {m}_j^\top \mathbf {m}_k$ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$); the gap has moderate predictive power but is noisier than $\sqrt {d}$}{figure.caption.70}{}}
