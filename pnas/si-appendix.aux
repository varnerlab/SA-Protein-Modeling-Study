\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf  {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt  {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ confirms bifurcation systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families.}}{15}{figure.caption.24}\protected@file@percent }
\newlabel{fig:bifurcation-analysis}{{S10}{15}{\textbf {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ confirms bifurcation systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S11}{\ignorespaces \textbf  {Stored-pattern probe analysis.} (A)~$\beta ^*$ from stored-pattern inflection vs.\ the value from the entropy inflection search. (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance. (C)~Variance ratio vs.\ $d$. (D)~The decomposition $\tau ^*_{\mathrm  {stored}}/\sigma _{\mathrm  {cross}}$ fails as a predictor ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta $ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$).}}{16}{figure.caption.25}\protected@file@percent }
\newlabel{fig:stored-pattern-analysis}{{S11}{16}{\textbf {Stored-pattern probe analysis.} (A)~$\beta ^*$ from stored-pattern inflection vs.\ the value from the entropy inflection search. (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance. (C)~Variance ratio vs.\ $d$. (D)~The decomposition $\tau ^*_{\mathrm {stored}}/\sigma _{\mathrm {cross}}$ fails as a predictor ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta $ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$)}{figure.caption.25}{}}
