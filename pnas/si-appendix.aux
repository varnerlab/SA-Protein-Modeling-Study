\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces Concordance between ESMFold and AlphaFold2 structure predictions for SA-generated sequences across all eight families. Each point is one family-condition pair. \textbf  {(A)}~pLDDT concordance ($r{=}0.434$); AlphaFold2 pLDDT values are systematically higher, reflecting differences in confidence calibration. \textbf  {(B)}~TM-score concordance ($r{=}0.999$); points lie on the identity line, confirming that the two predictors rank conditions identically.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:esmfold-af2-concordance}{{S4}{5}{Concordance between ESMFold and AlphaFold2 structure predictions for SA-generated sequences across all eight families. Each point is one family-condition pair. \textbf {(A)}~pLDDT concordance ($r{=}0.434$); AlphaFold2 pLDDT values are systematically higher, reflecting differences in confidence calibration. \textbf {(B)}~TM-score concordance ($r{=}0.999$); points lie on the identity line, confirming that the two predictors rank conditions identically}{figure.caption.7}{}}
