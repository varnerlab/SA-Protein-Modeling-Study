\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces \textbf  {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores. (B)~Similarity variance $\sigma ^2$ vs.\ $1/d$ for random probes; all points lie on the identity line. (C)~Gaussian prediction $\beta ^*_{\mathrm  {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; correct trend ($r = 0.98$) but overshoots by ${\sim }4\times $. (D)~Same as (C) using the empirical $\tau ^*$; overshoot persists. (E)~Excess kurtosis of the similarity distribution. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming $\sigma ^2 d = 1$.}}{13}{figure.caption.28}\protected@file@percent }
\newlabel{fig:analytical-beta-star}{{S8}{13}{\textbf {Analytical investigation of $\beta ^*$.} (A)~Dimensionless softmax inflection $\tau ^*(K)$ for Gaussian scores. (B)~Similarity variance $\sigma ^2$ vs.\ $1/d$ for random probes; all points lie on the identity line. (C)~Gaussian prediction $\beta ^*_{\mathrm {pred}} = \tau ^*_G(K)/\sigma $ vs.\ empirical $\beta ^*$; correct trend ($r = 0.98$) but overshoots by ${\sim }4\times $. (D)~Same as (C) using the empirical $\tau ^*$; overshoot persists. (E)~Excess kurtosis of the similarity distribution. (F)~The ratio $\sigma ^2 d$ across all datasets, confirming $\sigma ^2 d = 1$}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces \textbf  {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf  {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt  {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ confirms bifurcation systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families.}}{14}{figure.caption.29}\protected@file@percent }
\newlabel{fig:bifurcation-analysis}{{S9}{14}{\textbf {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ confirms bifurcation systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Stored-pattern probe analysis.} (A)~$\beta ^*$ from stored-pattern inflection vs.\ the value from the entropy inflection search. (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance. (C)~Variance ratio vs.\ $d$. (D)~The decomposition $\tau ^*_{\mathrm  {stored}}/\sigma _{\mathrm  {cross}}$ fails as a predictor ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta $ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$).}}{14}{figure.caption.30}\protected@file@percent }
\newlabel{fig:stored-pattern-analysis}{{S10}{14}{\textbf {Stored-pattern probe analysis.} (A)~$\beta ^*$ from stored-pattern inflection vs.\ the value from the entropy inflection search. (B)~Cross-similarity variance (stored probes) vs.\ random-probe variance. (C)~Variance ratio vs.\ $d$. (D)~The decomposition $\tau ^*_{\mathrm {stored}}/\sigma _{\mathrm {cross}}$ fails as a predictor ($R^2 = -9.0$). (E)~Self-similarity gap $\Delta $ vs.\ $d$. (F)~$\beta ^*$ vs.\ $1/\Delta $ ($r = 0.76$)}{figure.caption.30}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Generation metrics across eight Pfam families (mean $\pm $ SE). SA gen: generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: amino acid composition KL divergence ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat  {\boldsymbol  {\xi }}, \mathbf  {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better). Bold: best method per family and metric.}}{15}{table.caption.2}\protected@file@percent }
\newlabel{tab:results}{{S1}{15}{Generation metrics across eight Pfam families (mean $\pm $ SE). SA gen: generation regime ($\beta \approx 2\beta ^*$). SA ret: retrieval regime ($\beta \approx 20\beta ^*$). BS: bootstrap. GP: Gaussian perturbation. CC: convex combination. KL: amino acid composition KL divergence ($\downarrow $ lower is better; SE via 1{,}000-fold bootstrap). Novelty: $1 - \max _k\cos (\hat {\boldsymbol {\xi }}, \mathbf {m}_k)$ in PCA space ($\uparrow $ higher is better). SeqID: nearest sequence identity to a stored pattern after decoding ($\downarrow $ lower is better). Bold: best method per family and metric}{table.caption.2}{}}
