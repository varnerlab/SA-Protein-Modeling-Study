\@writefile{lof}{\contentsline {figure}{\numberline {S10}{\ignorespaces \textbf  {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf  {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt  {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ showing that the bifurcation estimate systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families.}}{16}{figure.caption.28}\protected@file@percent }
\newlabel{fig:bifurcation-analysis}{{S10}{16}{\textbf {Bifurcation-based prediction of $\beta ^*$.} (A)~$\beta _c = 1/\lambda _1(\mathbf {C})$ vs.\ empirical $\beta ^*$ ($r{=}0.479$); bifurcation overshoots by $3$--$5\times $. (B)~Second-moment predictor performance is identical. (C)~$\beta ^*$ vs.\ $\sqrt {d}$ with fitted model ($R^2{=}0.960$). (D)~Leading eigenvalue vs.\ $d$; no consistent relationship. (E)~Ratio $\beta ^*/\beta _c$ showing that the bifurcation estimate systematically overestimates. (F)~Normalized eigenvalue spectra for all eight families}{figure.caption.28}{}}
