\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces AlphaFold2 predicted structures for representative SA-generated sequences (colored by pLDDT) superimposed on experimentally determined reference structures (gray). Sub-angstrom predicted backbone RMSD despite $40$--$65\%$ sequence novelty.}}{12}{figure.caption.7}\protected@file@percent }
