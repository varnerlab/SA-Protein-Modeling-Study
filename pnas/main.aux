\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Predicting the critical temperature from MSA statistics. \textbf  {(A)}~Predicted vs.\ empirical $\beta ^*$ ($R^2{=}0.97$, $n{=}33$). Blue circles: Pfam families; gold diamonds: WW scaling replicates. \textbf  {(B)}~$\beta ^*$ vs.\ $\sqrt  {d}$, with fitted regression (dashed) and random-pattern prediction (dotted red). \textbf  {(C)}~Model comparison (log-scale root-mean-square error [RMSE]).}}{9}{figure.caption.3}\protected@file@percent }
\newlabel{fig:beta-prediction}{{2}{9}{Predicting the critical temperature from MSA statistics. \textbf {(A)}~Predicted vs.\ empirical $\beta ^*$ ($R^2{=}0.97$, $n{=}33$). Blue circles: Pfam families; gold diamonds: WW scaling replicates. \textbf {(B)}~$\beta ^*$ vs.\ $\sqrt {d}$, with fitted regression (dashed) and random-pattern prediction (dotted red). \textbf {(C)}~Model comparison (log-scale root-mean-square error [RMSE])}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Head-to-head comparison of SA against three learned baselines across all eight families. \textbf  {(A)}~KL divergence. \textbf  {(B)}~Novelty. \textbf  {(C)}~Nearest sequence identity. Per-chain means $\pm 1$ SE.}}{10}{figure.caption.4}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{3}{10}{Head-to-head comparison of SA against three learned baselines across all eight families. \textbf {(A)}~KL divergence. \textbf {(B)}~Novelty. \textbf {(C)}~Nearest sequence identity. Per-chain means $\pm 1$ SE}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Structure validation using ESMFold. \textbf  {(A)}~Mean pLDDT across eight families. Dashed line: pLDDT${=}70$ confidence threshold. \textbf  {(B)}~TM-score to experimentally determined reference structures. Dashed line: TM${=}0.5$ same-fold threshold. Significance: Wilcoxon rank-sum, $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. $n{=}50$ sequences per condition.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:structure-validation}{{4}{11}{Structure validation using ESMFold. \textbf {(A)}~Mean pLDDT across eight families. Dashed line: pLDDT${=}70$ confidence threshold. \textbf {(B)}~TM-score to experimentally determined reference structures. Dashed line: TM${=}0.5$ same-fold threshold. Significance: Wilcoxon rank-sum, $^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant. $n{=}50$ sequences per condition}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Biophysical properties of beta defensin sequences. \textbf  {(A)}~Net charge vs.\ hydrophobic fraction. \textbf  {(B)}~Cysteine count distribution. \textbf  {(C)}~Net charge distribution. \textbf  {(D)}~Antimicrobial plausibility filter pass rate.}}{11}{figure.caption.6}\protected@file@percent }
