\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Properties of the eight Pfam families used in this study. $K$: number of seed sequences after cleaning. $L$: alignment length. $d$: PCA dimension (95\% variance). $\bar  {H}_{\mathrm  {col}}$: mean per-column Shannon entropy (nats). $K_{\mathrm  {eff}}$: effective number of sequences at 80\% identity. $\beta ^*$: empirical entropy inflection point.}}{11}{table.caption.1}\protected@file@percent }
\newlabel{tab:families}{{1}{11}{Properties of the eight Pfam families used in this study. $K$: number of seed sequences after cleaning. $L$: alignment length. $d$: PCA dimension (95\% variance). $\bar {H}_{\mathrm {col}}$: mean per-column Shannon entropy (nats). $K_{\mathrm {eff}}$: effective number of sequences at 80\% identity. $\beta ^*$: empirical entropy inflection point}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cross-family comparison of SA generation, SA retrieval, and bootstrap across eight Pfam families. \textbf  {(A)}~KL divergence of amino acid composition (lower is better); dashed line at KL${=}0.05$. \textbf  {(B)}~Novelty in PCA space ($1 - \max _k \cos (\hat  {\xi }, \mathbf  {m}_k)$; higher is better). Bootstrap samples have zero novelty by construction. \textbf  {(C)}~Nearest sequence identity to a stored pattern; green shaded band (30--70\%) marks the typical within-family identity range. Error bars: $\pm 1$ SE (30 chains $\times $ 5 samples).}}{12}{figure.caption.2}\protected@file@percent }
\newlabel{fig:cross-family}{{1}{12}{Cross-family comparison of SA generation, SA retrieval, and bootstrap across eight Pfam families. \textbf {(A)}~KL divergence of amino acid composition (lower is better); dashed line at KL${=}0.05$. \textbf {(B)}~Novelty in PCA space ($1 - \max _k \cos (\hat {\xi }, \mathbf {m}_k)$; higher is better). Bootstrap samples have zero novelty by construction. \textbf {(C)}~Nearest sequence identity to a stored pattern; green shaded band (30--70\%) marks the typical within-family identity range. Error bars: $\pm 1$ SE (30 chains $\times $ 5 samples)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Predicting the critical temperature from MSA statistics. \textbf  {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt  {d}$ ($R^2{=}0.97$, $n{=}33$). Blue circles: eight Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots  ,400\}$, five repeats each). \textbf  {(B)}~$\beta ^*$ as a function of $\sqrt  {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt  {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf  {(C)}~Model comparison (log-scale RMSE). The fitted two-parameter model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt  {d}$ (RMSE${=}5.23$); adding MSA features provides negligible improvement.}}{13}{figure.caption.3}\protected@file@percent }
\newlabel{fig:beta-prediction}{{2}{13}{Predicting the critical temperature from MSA statistics. \textbf {(A)}~Predicted vs.\ empirical $\beta ^*$ for the simple linear model $\beta ^* \approx 1.52 + 0.28\sqrt {d}$ ($R^2{=}0.97$, $n{=}33$). Blue circles: eight Pfam families; gold diamonds: WW scaling replicates ($K \in \{20,\ldots ,400\}$, five repeats each). \textbf {(B)}~$\beta ^*$ as a function of $\sqrt {d}$, with the fitted regression (dashed) and the random-pattern prediction $\beta ^* = \sqrt {d}$ (dotted red). The intercept offset and reduced slope reflect structured correlations in real protein families. \textbf {(C)}~Model comparison (log-scale RMSE). The fitted two-parameter model (RMSE${=}0.16$) is $33\times $ more accurate than the naive random-pattern prediction $\beta ^* = \sqrt {d}$ (RMSE${=}5.23$); adding MSA features provides negligible improvement}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Head-to-head comparison of SA generation against three learned baselines across all eight Pfam families. \textbf  {(A)}~KL divergence of amino acid composition (bootstrap SE; $n_{\mathrm  {boot}}{=}1000$); dashed line at KL${=}0.05$. \textbf  {(B)}~Novelty in PCA space. \textbf  {(C)}~Nearest sequence identity to a stored pattern; green shaded band (30--70\%) marks the within-family identity range. Panels (B) and (C): per-chain means $\pm 1$ SE. Significance brackets: Wilcoxon rank-sum tests ($^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$). Per-family numerical values are reported in SI Appendix for the learned baselines (Table~\ref {SI-tab:baseline-metrics}) and for SA generation and the reference conditions (Table~\ref {SI-tab:results}).}}{14}{figure.caption.4}\protected@file@percent }
\newlabel{fig:baseline-comparison}{{3}{14}{Head-to-head comparison of SA generation against three learned baselines across all eight Pfam families. \textbf {(A)}~KL divergence of amino acid composition (bootstrap SE; $n_{\mathrm {boot}}{=}1000$); dashed line at KL${=}0.05$. \textbf {(B)}~Novelty in PCA space. \textbf {(C)}~Nearest sequence identity to a stored pattern; green shaded band (30--70\%) marks the within-family identity range. Panels (B) and (C): per-chain means $\pm 1$ SE. Significance brackets: Wilcoxon rank-sum tests ($^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$). Per-family numerical values are reported in SI Appendix for the learned baselines (Table~\ref {SI-tab:baseline-metrics}) and for SA generation and the reference conditions (Table~\ref {SI-tab:results})}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Structure validation using ESMFold. \textbf  {(A)}~Mean pLDDT across all eight families for SA generation, SA retrieval, bootstrap, and stored sequences; dashed line at pLDDT${=}70$. \textbf  {(B)}~TM-score to the experimentally determined reference structure; dashed line at TM${=}0.5$. Significance: Wilcoxon rank-sum tests ($^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant). Error bars: $\pm 1$ SE ($n{=}50$).}}{15}{figure.caption.5}\protected@file@percent }
\newlabel{fig:structure-validation}{{4}{15}{Structure validation using ESMFold. \textbf {(A)}~Mean pLDDT across all eight families for SA generation, SA retrieval, bootstrap, and stored sequences; dashed line at pLDDT${=}70$. \textbf {(B)}~TM-score to the experimentally determined reference structure; dashed line at TM${=}0.5$. Significance: Wilcoxon rank-sum tests ($^{***}p < 0.001$, $^{**}p < 0.01$, $^{*}p < 0.05$, n.s.\ = not significant). Error bars: $\pm 1$ SE ($n{=}50$)}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces AlphaFold2 predicted structures for representative SA-generated sequences (colored by per-residue pLDDT confidence) superimposed on the experimentally determined reference structure for each family (gray, semi-transparent). For each family, the SA-generated sequence with the highest mean pLDDT was selected and aligned to the reference using PyMOL. The close predicted structural agreement (sub-angstrom root-mean-square deviation (RMSD)) and uniformly high pLDDT scores are consistent with SA-generated sequences encoding three-dimensional folds that recapitulate the canonical architecture of their target family, despite $40$--$65\%$ sequence novelty.}}{15}{figure.caption.6}\protected@file@percent }
\newlabel{fig:structure-gallery}{{5}{15}{AlphaFold2 predicted structures for representative SA-generated sequences (colored by per-residue pLDDT confidence) superimposed on the experimentally determined reference structure for each family (gray, semi-transparent). For each family, the SA-generated sequence with the highest mean pLDDT was selected and aligned to the reference using PyMOL. The close predicted structural agreement (sub-angstrom root-mean-square deviation (RMSD)) and uniformly high pLDDT scores are consistent with SA-generated sequences encoding three-dimensional folds that recapitulate the canonical architecture of their target family, despite $40$--$65\%$ sequence novelty}{figure.caption.6}{}}
