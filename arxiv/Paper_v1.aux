\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf  {(A)}~KL divergence (log--log scale). Stochastic attention generation maintains low KL across the entire range; convex combination increases KL. \textbf  {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf  {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf  {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE.}}{22}{figure.caption.39}\protected@file@percent }
\newlabel{fig:scaling}{{S2}{22}{Scaling study: WW domain subsampled at $K \in \{20, 50, 100, 200, 400\}$ with five independent replicates. \textbf {(A)}~KL divergence (log--log scale). Stochastic attention generation maintains low KL across the entire range; convex combination increases KL. \textbf {(B)}~Novelty increases with $K$ for SA methods; baselines remain near zero. \textbf {(C)}~Nearest sequence identity decreases with $K$, indicating the sampler explores further from stored patterns as more patterns shape the energy landscape. \textbf {(D)}~The empirical critical temperature $\beta ^*$ increases with family size. Shaded regions and error bars show $\pm 1$ SE}{figure.caption.39}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S5}AlphaFold2 Cross-Validation}{23}{section.41}\protected@file@percent }
