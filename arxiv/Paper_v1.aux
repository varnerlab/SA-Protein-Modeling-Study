\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces Pairwise MI scatter plots for representative families. Each point represents one position pair $(i, j)$; the $x$-axis is MI from the stored seed alignment and the $y$-axis is MI from SA-generated sequences. Red points indicate structurally contacting residue pairs (C$\alpha $--C$\alpha $ distance ${<}8$~\r A, sequence separation ${\geq }5$ residues). Pearson $r$ and Spearman $\rho $ are shown in each panel.}}{26}{figure.caption.52}\protected@file@percent }
\newlabel{fig:mi-scatter}{{S6}{26}{Pairwise MI scatter plots for representative families. Each point represents one position pair $(i, j)$; the $x$-axis is MI from the stored seed alignment and the $y$-axis is MI from SA-generated sequences. Red points indicate structurally contacting residue pairs (C$\alpha $--C$\alpha $ distance ${<}8$~\AA , sequence separation ${\geq }5$ residues). Pearson $r$ and Spearman $\rho $ are shown in each panel}{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Pairwise MI preservation across all eight Pfam families. Each bar shows the Pearson correlation between the upper-triangle MI vector of the stored seed alignment and the MI vector of sequences generated by the indicated method. The general ordering HMM $<$ SA gen $<$ Potts $\leq $ EvoDiff reflects the information hierarchy of each model in several families, though Defensin\_beta is an exception where the Potts model ($r{=}0.23$) falls below both SA and HMM. On Pkinase, the shallowest family ($K{=}37$, $L{=}262$), SA generation is consensus-proximal and so carries little covariation ($r{=}0.05$), with HMM and MSAT similarly low; Potts ($r{=}0.95$) and EvoDiff recover the covariation through explicitly fitted couplings and large-scale pretraining.}}{26}{figure.caption.53}\protected@file@percent }
\newlabel{fig:mi-barplot}{{S7}{26}{Pairwise MI preservation across all eight Pfam families. Each bar shows the Pearson correlation between the upper-triangle MI vector of the stored seed alignment and the MI vector of sequences generated by the indicated method. The general ordering HMM $<$ SA gen $<$ Potts $\leq $ EvoDiff reflects the information hierarchy of each model in several families, though Defensin\_beta is an exception where the Potts model ($r{=}0.23$) falls below both SA and HMM. On Pkinase, the shallowest family ($K{=}37$, $L{=}262$), SA generation is consensus-proximal and so carries little covariation ($r{=}0.05$), with HMM and MSAT similarly low; Potts ($r{=}0.95$) and EvoDiff recover the covariation through explicitly fitted couplings and large-scale pretraining}{figure.caption.53}{}}
